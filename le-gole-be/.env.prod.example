# Database "produzione" (container Postgres avviato da docker-compose.yml) — separato dal
# database di sviluppo/test in .env. Vedi CLAUDE.md sezione 10.
DB_HOST=db
DB_PORT=5432
DB_NAME=le_gole_prod_db
DB_USER=le_gole_app
DB_PASSWORD=

# Stessi tre valori sopra, con i nomi richiesti dall'immagine ufficiale Postgres.
POSTGRES_DB=le_gole_prod_db
POSTGRES_USER=le_gole_app
POSTGRES_PASSWORD=
