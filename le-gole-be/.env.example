# Database di sviluppo/test (Postgres nativo in locale, ispezionabile con pgAdmin) — il
# database "produzione"/Docker ha le proprie credenziali separate in .env.prod.example, e un
# eventuale deploy su Render+Supabase (sezione 12 di CLAUDE.md) usa ancora altri valori, impostati
# direttamente nella dashboard Render, non in questo file.
DB_NAME=le_gole_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Opzionali, non impostati per l'esecuzione locale diretta (default rispettivamente '*' e
# nessuna OPTIONS aggiuntiva sulla connessione, invariati se ometti queste righe). Servono per
# un deploy con host/DB esterni (es. Render + Supabase, sezione 12): ALLOWED_HOSTS ristretto
# all'host reale, DB_SSLMODE=require perché Supabase accetta solo connessioni TLS,
# DB_CONN_HEALTH_CHECKS=True come rete di sicurezza contro una connessione riusata dopo che il
# server l'ha chiusa (es. dopo la pausa per inattività di Supabase sul piano free).
# ALLOWED_HOSTS=
# DB_SSLMODE=
# DB_CONN_HEALTH_CHECKS=

SECRET_KEY=

DEBUG=True

FRONTEND_ACTIVATION_URL=legole://activate
FRONTEND_RESET_URL=legole://reset-password

# Backend Resend (django-anymail) per le email transazionali (attivazione account/reset
# password staff, sezione 1 di CLAUDE.md).
RESEND_API_KEY=

# Cloudinary (storage foto prodotti menu asporto, menu.Prodotto.immagine, sezione 1). Credenziali
# dalla dashboard Cloudinary del progetto (Settings > Access Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
