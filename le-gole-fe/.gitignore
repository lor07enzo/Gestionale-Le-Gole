# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# netlify-cli local site link (netlify link/init), machine-specific
.netlify

# jest --coverage output (rigenerato in CI per SonarQube, sezione 9/13 di CLAUDE.md)
coverage/

# generated native folders
/ios
/android

# Chiave privata del service account Firebase (FCM V1, sezione 11 di CLAUDE.md):
# va caricata SOLO su EAS con `eas credentials`, mai committata.
# google-services.json invece NON va qui: EAS Build rispetta .gitignore e senza
# quel file l'app non riesce a registrarsi su FCM.
*firebase-adminsdk*.json
google-service-account*.json
